# Environment variables template untuk SUKU-Monitor
# SALIN file ini menjadi .env (JANGAN commit .env ke git!)

# Mode: development / production
APP_ENV=development
APP_PORT=8000
SECRET_KEY=ganti-dengan-string-acak-panjang-disini

# Database (PostgreSQL untuk production, SQLite bawaan untuk testing lokal)
# Contoh SQLite (default):
